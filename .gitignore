# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Data (too large for git; download via scripts/download_data.py)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
*.h5
*.hdf5
*.pkl
*.pickle

# Trained models and generated artifacts
models/*
!models/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
!outputs/figures/*.png
outputs/metrics/*
!outputs/metrics/.gitkeep
!outputs/metrics/*.json
!outputs/metrics/*.md
outputs/predictions/*
!outputs/predictions/.gitkeep
outputs/routing/*
!outputs/routing/.gitkeep
logs/
*.log

# Keep small JSON/CSV experiment logs if committed later via explicit add
# (default: ignore large generated outputs)
